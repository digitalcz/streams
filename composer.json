{
  "name": "digitalcz/streams",
  "description": "Opinionated abstraction around PHP streams implementing PSR-7 StreamInterface",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "streams",
    "file"
  ],
  "authors": [
    {
      "name": "Digital Solutions s.r.o.",
      "email": "devs@digital.cz",
      "homepage": "https://digital.cz",
      "role": "Developer"
    },
    {
      "name": "Pavel Stejskal",
      "email": "spajxo@gmail.com",
      "homepage": "https://github.com/spajxo",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/digitalcz/streams",
  "require": {
    "php": "^8.1",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "digitalcz/coding-standard": "^0.5.0",
    "ergebnis/composer-normalize": "^2.50",
    "php-http/psr7-integration-tests": "^1.5",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1.39",
    "phpstan/phpstan-phpunit": "^2.0.16",
    "phpstan/phpstan-strict-rules": "^2.0.10",
    "phpunit/phpunit": "^10.5 || ^11.5",
    "slevomat/coding-standard": "^8.27",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/var-dumper": "^6.4 || ^7.4"
  },
  "autoload": {
    "psr-4": {
      "DigitalCz\\Streams\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalCz\\Streams\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "checks": [
      "@cs",
      "@phpstan",
      "@tests"
    ],
    "cs": "phpcs -p",
    "csfix": "phpcbf -p",
    "phpstan": "phpstan analyse",
    "tests": "phpunit"
  }
}
